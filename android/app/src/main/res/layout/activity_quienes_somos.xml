<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#005F99"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLogoHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOBII"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#007ACC"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️ Quiénes Somos"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F7F9FC"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuestra Misión"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#005F99"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En Accesibilidad Urbana, lideramos la transformación de las ciudades hacia un entorno más inclusivo, accesible y cómodo para todos. Nos especializamos en integrar tecnología avanzada con soluciones urbanas prácticas, ofreciendo soluciones innovadoras para personas con movilidad reducida."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué nos hace diferentes?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#005F99"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Innovación: Soluciones tecnológicas para problemas reales de movilidad.\n• Compromiso: Mejorar la calidad de vida de las personas discapacitadas.\n• Inclusión: Servicios accesibles que marcan la diferencia."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingMultiplier="1.6"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/btnContacto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📬 Contacto"
                android:backgroundTint="#007ACC"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnEquipo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="👤 Nuestro Equipo"
                android:backgroundTint="#007ACC"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="4dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#005F99">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Ayúdanos a mejorar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu opinión es clave para hacer MOBII mejor cada día."
                        android:textSize="13sp"
                        android:textColor="#DBEFFF"
                        android:layout_marginBottom="14dp"/>

                    <Button
                        android:id="@+id/btnFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Enviar tu opinión"
                        android:backgroundTint="#FFFFFF"
                        android:textColor="#005F99"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F7F9FC"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objetivos de Desarrollo Sostenible"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#005F99"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ODS 10 — Reducción de las desigualdades"
                        android:textStyle="bold" android:textColor="#005F99"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Promovemos la inclusión social y la igualdad de oportunidades."
                        android:textColor="#555555" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ODS 11 — Ciudades y comunidades sostenibles"
                        android:textStyle="bold" android:textColor="#005F99"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Facilitamos el acceso a infraestructuras urbanas inclusivas."
                        android:textColor="#555555" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="2dp"
                app:cardCornerRadius="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ODS 9 — Industria, innovación e infraestructura"
                        android:textStyle="bold" android:textColor="#005F99"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Diseñamos sistemas inteligentes y accesibles."
                        android:textColor="#555555" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:text="© 2025 MOBII — Jorge Ferrer Gil"
            android:textColor="#90A4AE"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
