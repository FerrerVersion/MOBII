<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Saludo personalizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Bienvenido/a!"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movilidad sin barreras en Valencia"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Sección 1: Quiénes somos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/logo3"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiénes somos"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MOBII es una aplicación diseñada para facilitar la movilidad urbana de personas con discapacidad en Valencia. Nuestro objetivo es ofrecer información accesible, actualizada y personalizada para que puedas moverte con plena autonomía."
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Sección 2: Qué puedes hacer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué puedes hacer?"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="16dp" />

            <!-- Parking -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                    android:text="🅿️" android:textSize="22sp" android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Aparcamiento adaptado" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Localiza plazas PMR en tiempo real" android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Taxi -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                    android:text="🚕" android:textSize="22sp" android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pedir taxi adaptado" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Reserva con recogida en tu puerta" android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Actividades -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="14dp">
                <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                    android:text="🎭" android:textSize="22sp" android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Actividades accesibles" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cafés, restaurantes, museos y más" android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Centros -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="36dp" android:layout_height="wrap_content"
                    android:text="🏛️" android:textSize="22sp" android:gravity="center" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Centros especializados" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Centros por tipo de discapacidad" android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Sección 3: Accesibilidad primero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorSurface"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="♿" android:textSize="22sp" android:paddingEnd="10dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Accesibilidad primero"
                    android:textSize="17sp" android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="En tu perfil puedes indicar tu tipo de discapacidad de forma opcional. Esta información nos permite mostrarte los recursos que mejor se adaptan a tus necesidades — sin compartirla con terceros."
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Puedes añadirla o editarla en cualquier momento desde la sección de Ajustes → Mi perfil."
                android:textSize="13sp"
                android:textColor="@color/colorPrimary"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="© 2025 MOBII — Jorge Ferrer Gil"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
