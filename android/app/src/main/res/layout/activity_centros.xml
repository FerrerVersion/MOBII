<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#005F99"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOBII"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#007ACC"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo: "
                android:textColor="#DBEFFF"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <Spinner
                android:id="@+id/spinnerDiscapacidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webViewCentros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
