<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#005F99"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOBII"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#007ACC"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚕 Pedir Taxi Adaptado"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="14dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionMenuTaxi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué quieres hacer?"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#005F99"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnReservarTaxi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Reservar Taxi Adaptado"
            android:backgroundTint="#007ACC"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnMisCitas"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📋 Mis Citas"
            android:backgroundTint="#005F99"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/sectionFormTaxi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solicita tu Taxi Adaptado"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#005F99"
                android:layout_marginBottom="16dp"/>

            <EditText android:id="@+id/etNombreReserva" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Nombre de la reserva"
                android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📍 Punto de Recogida" android:textStyle="bold"
                android:textColor="#005F99" android:layout_marginTop="8dp"/>

            <EditText android:id="@+id/etCalleRecogida" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Calle" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText android:id="@+id/etNumRecogida" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="Número" android:inputType="number" android:layout_marginEnd="4dp"/>
                <EditText android:id="@+id/etCpRecogida" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="C.P." android:inputType="number"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏁 Punto de Destino" android:textStyle="bold"
                android:textColor="#005F99" android:layout_marginTop="12dp"/>

            <EditText android:id="@+id/etCalleDestino" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Calle" android:layout_marginBottom="4dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText android:id="@+id/etNumDestino" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="Número" android:inputType="number" android:layout_marginEnd="4dp"/>
                <EditText android:id="@+id/etCpDestino" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:hint="C.P." android:inputType="number"/>
            </LinearLayout>

            <EditText android:id="@+id/etFecha" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Fecha (dd/mm/aaaa)"
                android:layout_marginTop="8dp"/>
            <EditText android:id="@+id/etHora" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Hora (hh:mm)"
                android:inputType="time" android:layout_marginTop="4dp"/>
            <EditText android:id="@+id/etTelefono" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:hint="Teléfono de contacto"
                android:inputType="phone" android:layout_marginTop="4dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Número de plazas:" android:textColor="#005F99"
                android:textStyle="bold" android:layout_marginTop="12dp"/>

            <Spinner android:id="@+id/spinnerPlazas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>

            <Button android:id="@+id/btnEnviarReserva" android:layout_width="match_parent"
                android:layout_height="56dp" android:text="Reservar"
                android:backgroundTint="#007ACC" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"/>

            <Button android:id="@+id/btnVolverForm" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="← Volver"
                android:backgroundTint="#90A4AE" android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/sectionMisCitas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Mis Citas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#005F99"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/tvSinCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay citas reservadas."
            android:gravity="center"
            android:textColor="#90A4AE"
            android:padding="32dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCitas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"/>

        <Button
            android:id="@+id/btnVolverCitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:backgroundTint="#90A4AE"
            android:textColor="#FFFFFF"
            android:layout_margin="16dp"/>
    </LinearLayout>
</LinearLayout>
