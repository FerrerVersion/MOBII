<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#005F99"
        android:orientation="vertical"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvLogoHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOBII"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#007ACC"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🅿️ Aparcamientos Adaptados"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/btnVerTodos"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📋 Todos"
                android:backgroundTint="#004C7A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnVerFavoritos"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⭐ Favoritos"
                android:backgroundTint="#007ACC"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E3F2FD">

        <TextView
            android:id="@+id/tvEstadoParking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cargando..."
            android:textColor="#005F99"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ProgressBar
            android:id="@+id/progressBarParking"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:indeterminate="true"
            android:visibility="gone"/>
    </RelativeLayout>

    <WebView
        android:id="@+id/webViewParkingMapa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fuente: Open Data Valencia"
        android:textSize="10sp"
        android:textColor="#90A4AE"
        android:gravity="center"
        android:padding="5dp"
        android:background="#FFFFFF"/>

</LinearLayout>